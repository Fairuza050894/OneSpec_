{
  "name": "OneSpec SDLC Studio",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"FASTIFY,NEXT\" -c \"blue.bold,cyan.bold\" \"pnpm run dev:server\" \"pnpm run dev:next\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:next": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "concurrently -k -p \"[{name}]\" -n \"FASTIFY,NEXT\" -c \"blue.bold,cyan.bold\" \"pnpm run start:server\" \"pnpm run start:next\"",
    "start:server": "tsx src/server/index.ts",
    "start:next": "next start -p 3000",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test:types": "tsc --noEmit",
    "test:workbook-sections": "tsx scripts/check-workbook-sections.ts",
    "test:vault-diff": "tsx scripts/check-vault-snapshot-diff.ts",
    "test:docx-delta": "tsx scripts/check-docx-delta.ts",
    "test:product-knowledge": "tsx scripts/check-product-knowledge.ts",
    "test:screenshot-guard": "tsx scripts/check-screenshot-guard.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/websocket": "^11.3.6",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "@scalar/api-reference-react": "^0.9.87",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.1",
    "bpmn-js": "^18.31.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "docx": "^9.15.3",
    "elkjs": "^0.12.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "rea-agents": "^6.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^2.1.9",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
