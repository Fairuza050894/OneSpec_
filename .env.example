# OneSpec SDLC Studio - Environment Configuration Template
# Copy this file to .env or .env.local for local customization

# Application Ports & URLs
PORT=3000
ONESPEC_BASE_URL="http://127.0.0.1:3000"
ONESPEC_RUNNER_WS_PORT=8080

# Fastify Runner & WebSocket Server
FASTIFY_PORT=8080
FASTIFY_HOST=127.0.0.1
NEXT_PUBLIC_API_URL="http://127.0.0.1:8080"
NEXT_PUBLIC_WS_URL="ws://127.0.0.1:8080/ws/runner-stream"

# Local SQLite Storage (Prisma)
DATABASE_URL="file:./dev.db"
